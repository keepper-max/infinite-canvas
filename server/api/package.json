{
  "name": "@infinite-canvas/platform-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "credits:code": "tsx scripts/generate-activation-code.ts",
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "worker": "node dist/worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "tsx src/db/migrate-cli.ts",
    "assets:backfill-video-thumbnails": "node dist/db/backfill-video-thumbnails-cli.js",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts"
  },
  "dependencies": {
    "@alicloud/dm20151123": "^1.11.0",
    "@alicloud/openapi-core": "^1.0.8",
    "@aws-sdk/client-s3": "^3.1128.0",
    "@aws-sdk/s3-request-presigner": "^3.1128.0",
    "@hono/node-server": "2.1.1",
    "alipay-sdk": "4.14.0",
    "argon2": "0.45.1",
    "bullmq": "^6.3.4",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.7",
    "ioredis": "^6.0.0",
    "pg": "8.23.0",
    "zod": "4.5.4"
  },
  "overrides": {
    "urllib": "4.9.1"
  },
  "devDependencies": {
    "@types/node": "22.18.1",
    "@types/pg": "8.15.5",
    "tsx": "4.23.13",
    "typescript": "5.9.2"
  }
}
