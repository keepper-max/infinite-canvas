{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "version": {
      "type": "number",
      "const": 1
    },
    "type": {
      "type": "string",
      "enum": [
        "transform",
        "animation",
        "transition",
        "filter",
        "audio"
      ]
    },
    "target": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "clip",
            "track",
            "subtitle",
            "boundary"
          ]
        },
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "next_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": false
    },
    "start": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "end": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "enabled": {
      "type": "boolean"
    },
    "interpolation": {
      "type": "string",
      "enum": [
        "linear",
        "easeIn",
        "easeOut",
        "easeInOut",
        "hold"
      ]
    },
    "params": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "y": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "scale": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 4
        },
        "rotation": {
          "type": "number",
          "minimum": -360,
          "maximum": 360
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "brightness": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "contrast": {
          "type": "number",
          "minimum": 0,
          "maximum": 3
        },
        "saturation": {
          "type": "number",
          "minimum": 0,
          "maximum": 3
        },
        "blur": {
          "type": "number",
          "minimum": 0,
          "maximum": 20
        },
        "sharpen": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "gain": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "style": {
          "type": "string",
          "enum": [
            "cut",
            "dissolve",
            "fade",
            "fadeblack",
            "slideleft",
            "slideright",
            "wipeleft",
            "wiperight"
          ]
        }
      },
      "additionalProperties": false
    },
    "keyframes": {
      "maxItems": 128,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "at": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "values": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number",
                "minimum": -1,
                "maximum": 1
              },
              "y": {
                "type": "number",
                "minimum": -1,
                "maximum": 1
              },
              "scale": {
                "type": "number",
                "minimum": 0.1,
                "maximum": 4
              },
              "rotation": {
                "type": "number",
                "minimum": -360,
                "maximum": 360
              },
              "opacity": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "brightness": {
                "type": "number",
                "minimum": -1,
                "maximum": 1
              },
              "contrast": {
                "type": "number",
                "minimum": 0,
                "maximum": 3
              },
              "saturation": {
                "type": "number",
                "minimum": 0,
                "maximum": 3
              },
              "blur": {
                "type": "number",
                "minimum": 0,
                "maximum": 20
              },
              "sharpen": {
                "type": "number",
                "minimum": 0,
                "maximum": 2
              },
              "gain": {
                "type": "number",
                "minimum": 0,
                "maximum": 2
              }
            },
            "additionalProperties": false
          },
          "interpolation": {
            "type": "string",
            "enum": [
              "linear",
              "easeIn",
              "easeOut",
              "easeInOut",
              "hold"
            ]
          }
        },
        "required": [
          "at",
          "values",
          "interpolation"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "version",
    "type",
    "target",
    "start",
    "end",
    "enabled",
    "interpolation",
    "params",
    "keyframes"
  ],
  "additionalProperties": false
}