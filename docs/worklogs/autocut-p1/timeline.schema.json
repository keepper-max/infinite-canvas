{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 2
    },
    "project_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "revision_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "target_duration": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 1800000
    },
    "aspect_ratio": {
      "type": "string",
      "enum": [
        "16:9",
        "9:16",
        "1:1"
      ]
    },
    "fps": {
      "anyOf": [
        {
          "type": "number",
          "const": 25
        },
        {
          "type": "number",
          "const": 30
        }
      ]
    },
    "tracks": {
      "minItems": 1,
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "kind": {
            "type": "string",
            "enum": [
              "video",
              "audio"
            ]
          },
          "role": {
            "type": "string",
            "enum": [
              "main",
              "overlay",
              "original",
              "music"
            ]
          },
          "layer": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "muted": {
            "type": "boolean"
          },
          "volume": {
            "type": "number",
            "minimum": 0,
            "maximum": 2
          },
          "clips": {
            "maxItems": 200,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                },
                "asset_id": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                },
                "asset_version_id": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                },
                "source_in": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "source_out": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "timeline_start": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "speed": {
                  "type": "number",
                  "minimum": 0.25,
                  "maximum": 4
                },
                "effects": {
                  "type": "object",
                  "properties": {
                    "volume": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 2
                    },
                    "muted": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "volume",
                    "muted"
                  ],
                  "additionalProperties": false
                },
                "linked_clip_id": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                }
              },
              "required": [
                "id",
                "asset_id",
                "asset_version_id",
                "source_in",
                "source_out",
                "timeline_start",
                "speed",
                "effects"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "name",
          "kind",
          "role",
          "layer",
          "muted",
          "volume",
          "clips"
        ],
        "additionalProperties": false
      }
    },
    "subtitles": {
      "maxItems": 2000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "start": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "end": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "kind": {
            "type": "string",
            "enum": [
              "subtitle",
              "title"
            ]
          },
          "layer": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "font_size": {
            "type": "number",
            "minimum": 8,
            "maximum": 120
          },
          "color": {
            "type": "string",
            "pattern": "^#[a-fA-F0-9]{6}$"
          },
          "x": {
            "type": "number",
            "minimum": -1,
            "maximum": 1
          },
          "y": {
            "type": "number",
            "minimum": -1,
            "maximum": 1
          },
          "anchor": {
            "type": "object",
            "properties": {
              "clip_id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "source_in": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "source_out": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "clip_id",
              "source_in",
              "source_out"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "start",
          "end",
          "text",
          "kind",
          "layer",
          "font_size",
          "color",
          "x",
          "y"
        ],
        "additionalProperties": false
      }
    },
    "effect_stack": {
      "maxItems": 1000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "version": {
            "type": "number",
            "const": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "transform",
              "animation",
              "transition",
              "filter",
              "audio"
            ]
          },
          "target": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "clip",
                  "track",
                  "subtitle",
                  "boundary"
                ]
              },
              "id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "next_id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              }
            },
            "required": [
              "kind",
              "id"
            ],
            "additionalProperties": false
          },
          "start": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "end": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "enabled": {
            "type": "boolean"
          },
          "interpolation": {
            "type": "string",
            "enum": [
              "linear",
              "easeIn",
              "easeOut",
              "easeInOut",
              "hold"
            ]
          },
          "params": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number",
                "minimum": -1,
                "maximum": 1
              },
              "y": {
                "type": "number",
                "minimum": -1,
                "maximum": 1
              },
              "scale": {
                "type": "number",
                "minimum": 0.1,
                "maximum": 4
              },
              "rotation": {
                "type": "number",
                "minimum": -360,
                "maximum": 360
              },
              "opacity": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "brightness": {
                "type": "number",
                "minimum": -1,
                "maximum": 1
              },
              "contrast": {
                "type": "number",
                "minimum": 0,
                "maximum": 3
              },
              "saturation": {
                "type": "number",
                "minimum": 0,
                "maximum": 3
              },
              "blur": {
                "type": "number",
                "minimum": 0,
                "maximum": 20
              },
              "sharpen": {
                "type": "number",
                "minimum": 0,
                "maximum": 2
              },
              "gain": {
                "type": "number",
                "minimum": 0,
                "maximum": 2
              },
              "style": {
                "type": "string",
                "enum": [
                  "cut",
                  "dissolve",
                  "fade",
                  "fadeblack",
                  "slideleft",
                  "slideright",
                  "wipeleft",
                  "wiperight"
                ]
              }
            },
            "additionalProperties": false
          },
          "keyframes": {
            "maxItems": 128,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "at": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "values": {
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "number",
                      "minimum": -1,
                      "maximum": 1
                    },
                    "y": {
                      "type": "number",
                      "minimum": -1,
                      "maximum": 1
                    },
                    "scale": {
                      "type": "number",
                      "minimum": 0.1,
                      "maximum": 4
                    },
                    "rotation": {
                      "type": "number",
                      "minimum": -360,
                      "maximum": 360
                    },
                    "opacity": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "brightness": {
                      "type": "number",
                      "minimum": -1,
                      "maximum": 1
                    },
                    "contrast": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 3
                    },
                    "saturation": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 3
                    },
                    "blur": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 20
                    },
                    "sharpen": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 2
                    },
                    "gain": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 2
                    }
                  },
                  "additionalProperties": false
                },
                "interpolation": {
                  "type": "string",
                  "enum": [
                    "linear",
                    "easeIn",
                    "easeOut",
                    "easeInOut",
                    "hold"
                  ]
                }
              },
              "required": [
                "at",
                "values",
                "interpolation"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "version",
          "type",
          "target",
          "start",
          "end",
          "enabled",
          "interpolation",
          "params",
          "keyframes"
        ],
        "additionalProperties": false
      }
    },
    "audio_settings": {
      "type": "object",
      "properties": {
        "master_volume": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        }
      },
      "required": [
        "master_volume"
      ],
      "additionalProperties": false
    },
    "export_settings": {
      "type": "object",
      "properties": {
        "codec": {
          "type": "string",
          "const": "h264"
        },
        "format": {
          "type": "string",
          "const": "mp4"
        },
        "resolution": {
          "type": "number",
          "const": 720
        }
      },
      "required": [
        "codec",
        "format",
        "resolution"
      ],
      "additionalProperties": false
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 2000
      }
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "revision_id",
    "target_duration",
    "aspect_ratio",
    "fps",
    "tracks",
    "subtitles",
    "effect_stack",
    "audio_settings",
    "export_settings",
    "warnings"
  ],
  "additionalProperties": false
}