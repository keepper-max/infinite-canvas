    "build": "next build && node scripts/site-bundle.mjs",
    "sites:build": "opennextjs-cloudflare build",
    "start": "next start",
    "start:prod": "npm run db:init && npm run start",
    "lint": "eslint .",
    "worker": "tsx scripts/mock-worker.ts",
    "db:init": "node scripts/db-init.mjs",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "test:unit": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@alicloud/dysmsapi20170525": "^4.6.0",
    "@alicloud/openapi-client": "^0.4.15",
