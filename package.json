{
  "name": "jingjie-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "mcp:bundle": "esbuild scripts/shoushou-mcp-server.ts --bundle --platform=node --format=cjs --target=node22 --outfile=H:/CodexStorage/shoushou-mcp/shoushou-mcp-server.cjs",
    "mcp:shoushou": "tsx scripts/shoushou-mcp.ts",
    "credits:code": "tsx scripts/generate-activation-code.ts",
