    "@aws-sdk/client-s3": "^3.1116.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@xyflow/react": "^12.8.5",
    "alipay-sdk": "^4.14.0",
    "argon2": "^0.45.1",
    "bullmq": "^6.2.0",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^6.0.0",
    "lucide-react": "^0.468.0",
    "next": "^16.3.3",
    "nodemailer": "^10.0.15",
    "pg": "^8.23.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zod": "^4.6.5"
  },
  "overrides": {
    "qs": "^6.16.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.4",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.17.0",
    "eslint-config-next": "16.1.6",
    "tsx": "^4.23.12",
    "typescript": "^5.7.2",
    "wrangler": "^4.127.0"
  }
