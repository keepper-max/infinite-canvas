# Opt-in CPU image. Build the current API target first and supply its immutable digest.
ARG AUTOCUT_API_IMAGE
FROM ${AUTOCUT_API_IMAGE}
ARG AUTOCUT_API_IMAGE
ARG DEBIAN_SNAPSHOT
# Bootstrap the system trust store from the base image signed APT repositories.
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*
RUN echo "$AUTOCUT_API_IMAGE" | grep -Eq '(^sha256:[0-9a-f]{64}$|@sha256:[0-9a-f]{64}$)' \
    && echo "$DEBIAN_SNAPSHOT" | grep -Eq '^[0-9]{8}T[0-9]{6}Z$' \
    && test -f /app/dist/autocut/resident-asr.js \
    && printf 'Types: deb\nURIs: https://snapshot.debian.org/archive/debian/%s/\nSuites: bookworm bookworm-updates\nComponents: main\nSigned-By: /usr/share/keyrings/debian-archive-keyring.gpg\nCheck-Valid-Until: no\n\nTypes: deb\nURIs: https://snapshot.debian.org/archive/debian-security/%s/\nSuites: bookworm-security\nComponents: main\nSigned-By: /usr/share/keyrings/debian-archive-keyring.gpg\nCheck-Valid-Until: no\n' "$DEBIAN_SNAPSHOT" "$DEBIAN_SNAPSHOT" > /etc/apt/sources.list.d/debian.sources \
    && apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-venv libsndfile1 \
    && rm -rf /var/lib/apt/lists/*
COPY server/api/requirements-autocut-build.lock server/api/requirements-autocut-cpu.lock /app/
RUN python3 -m venv /opt/autocut-asr \
    && /opt/autocut-asr/bin/pip install --no-cache-dir --require-hashes --no-build-isolation -r /app/requirements-autocut-build.lock \
    && /opt/autocut-asr/bin/pip install --no-cache-dir --require-hashes --no-build-isolation --index-url https://pypi.org/simple --extra-index-url https://download.pytorch.org/whl/cpu -r /app/requirements-autocut-cpu.lock \
    && /opt/autocut-asr/bin/python -c "import torch,funasr,torchaudio; assert torch.version.cuda is None; print('CPU ASR imports verified')"
COPY server/api/scripts/autocut-asr.py server/api/scripts/autocut-model-manifest.py server/api/scripts/autocut-worker-entrypoint.sh /app/scripts/
RUN chmod 755 /app/scripts/autocut-worker-entrypoint.sh
ENV AUTOCUT_ASR_PYTHON=/opt/autocut-asr/bin/python \
    HF_HUB_OFFLINE=1 MODELSCOPE_OFFLINE=1 PYTHONDONTWRITEBYTECODE=1 \
    OMP_NUM_THREADS=2 MKL_NUM_THREADS=2 OPENBLAS_NUM_THREADS=2
CMD ["/app/scripts/autocut-worker-entrypoint.sh"]
