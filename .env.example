# Required for the built-in model channel. Keep the real value only in `.env` on the server.
TOKEN360_API_KEY=

# Optional. Direct access is the default. On an ECS host with the host forwarding service use:
# TOKEN360_UPSTREAM=http://host.docker.internal:8787
TOKEN360_UPSTREAM=https://api.token360.ai

# Optional model catalog endpoint. The public catalog does not require the API key.
TOKEN360_CATALOG_URL=https://api.token360.ai/public/models?size=200&current=1

# 海马云托管渠道。密钥只填写在服务端 `.env`，不要放进前端或提交到 Git。
RH_API_KEY=
RH_API_BASE_URL=https://www.runninghub.cn/openapi/v2
RH_MODEL_REGISTRY_URL=https://raw.githubusercontent.com/HM-RunningHub/ComfyUI_RH_OpenAPI/main/developer-kit/model-registry.public.json

# 海马云国际区。使用独立的 Enterprise-Shared Key，不要复用中国区密钥。
RH_GLOBAL_API_KEY=
RH_GLOBAL_API_BASE_URL=https://www.runninghub.ai/openapi/v2

# Development-only rollback. Production builds keep browser-side provider credentials disabled.
VITE_ALLOW_BROWSER_PROVIDERS=false

# Optional immutable image overrides used by the production cutover scripts.
WEB_IMAGE=keepper-max/infinite-canvas-web:local
API_IMAGE=keepper-max/infinite-canvas-api:local

# Background generation queue. Defaults reflect the confirmed operating profile.
REDIS_URL=redis://redis:6379
REDIS_IMAGE=redis:7-alpine
JOB_QUEUE_NAME=generation-jobs
TRANSFER_QUEUE_NAME=generation-transfers
TRANSFER_WORKER_CONCURRENCY=4
COMPOSITION_QUEUE_NAME=composition-jobs
COMPOSITION_WORKER_CONCURRENCY=1
FFMPEG_PATH=ffmpeg
WORKER_CONCURRENCY=2
JOB_MAX_ATTEMPTS=3
PROVIDER_SUBMIT_TIMEOUT_MS=0
VIDEO_POLL_INTERVAL_MS=2000
JOB_MAX_RUNTIME_MS=0

# Platform API and PostgreSQL. Set a strong password outside Git.
POSTGRES_USER=studio
POSTGRES_PASSWORD=
POSTGRES_DB=jingjie
# Optional registry override for hosts that cannot reach Docker Hub.
POSTGRES_IMAGE=postgres:16-alpine
COOKIE_SECURE=false
TRUSTED_ORIGINS=http://localhost:3000
SESSION_DAYS=14
# Comma-separated platform administrators. Keep empty until an account is deliberately promoted.
ADMIN_EMAILS=

# Object storage. Use MinIO locally; point both endpoints at an OSS S3-compatible
# endpoint in production. Keep real access credentials only in the server `.env`.
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=infinite-canvas-assets
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_FORCE_PATH_STYLE=true
OBJECT_STORAGE_AUTO_CREATE_BUCKET=true
MINIO_IMAGE=minio/minio:latest
MINIO_API_BIND=127.0.0.1
MINIO_CONSOLE_BIND=127.0.0.1
