# 生产环境必须替换为 ECS 内网地址或云数据库地址
DATABASE_URL=postgresql://studio:change-me@db:5432/jingjie
REDIS_URL=redis://redis:6379

# MinIO / OSS S3 兼容存储
S3_ENDPOINT=http://minio:9000
S3_BUCKET=jingjie-assets
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me

# HTTPS 域名上线后改为 true
COOKIE_SECURE=true

# 预留接口状态开关；不填也不会影响 Mock 任务
CREDITS_PROVIDER=mock
PAYMENT_PROVIDER=unconfigured
PAYMENT_ENABLED=false
PAYMENT_COMPLIANCE_APPROVED=false
# 审核通过且确认经营资质后，才在服务器配置以下环境变量；不要提交真实密钥。
ALIPAY_APP_ID=
ALIPAY_APP_PRIVATE_KEY_PEM=
ALIPAY_PUBLIC_KEY_PEM=
ALIPAY_SELLER_ID=
SERVICE_OPERATOR_NAME=
SERVICE_SUPPORT_EMAIL=
PUBLIC_BASE_URL=
# 可单独配置；留空时复用 SESSION_SECRET，并通过用途前缀隔离签名。
PROVIDER_ASSET_SIGNING_SECRET=
# 美元计费供应商的实际结算金额换算成人民币时使用；上线前需确定并公示。
USD_CNY_RATE=
# 验证码（服务端使用；VERIFICATION_CODE_SECRET 至少 16 位且不要提交真实值）
VERIFICATION_CODE_SECRET=change-this-verification-secret
VERIFY_CODE_EXPIRE_SECONDS=300
VERIFY_CODE_RESEND_SECONDS=60
VERIFY_CODE_MAX_ATTEMPTS=5
VERIFY_CODE_ACCOUNT_HOURLY_LIMIT=5
VERIFY_CODE_ACCOUNT_DAILY_LIMIT=10
VERIFY_CODE_IP_HOURLY_LIMIT=30
REGISTRATION_INVITE_REQUIRED=false

# 阿里云短信（RAM 用户最小权限；真实密钥仅配置在部署环境）
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=

# SMTP 邮箱验证码
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=守守画布

# 积分激活码发放管理员用户 ID（需先注册账号），逗号分隔；不配置则不能发码。
# 不使用邮箱授权：当前注册无邮箱验证，邮箱可能被抢先注册。请勿对外售卖激活码。
ACTIVATION_ADMIN_USER_IDS=
# 后台用户管理管理员 UUID，逗号分隔；同时兼容上面的激活码管理员名单。
ADMIN_USER_IDS=

# OpenAI-compatible AI gateway (keep the real key out of git)
TOKEN360_API_KEY=
ASSISTANT_BASE_URL=https://api.token360.ai/v1
ASSISTANT_MODEL=qwen3.8-flash

# Codex -> 守守画布本机 MCP（填写用户 UUID 或已注册邮箱/手机号之一）
SHOUSHOU_MCP_USER_ID=
SHOUSHOU_MCP_ACCOUNT=
# MCP 在宿主机运行时可单独覆盖容器内服务地址，例如 PostgreSQL 使用 127.0.0.1:55432。
SHOUSHOU_MCP_DATABASE_URL=
SHOUSHOU_MCP_REDIS_URL=
SHOUSHOU_MCP_S3_ENDPOINT=
# 可选：逗号分隔的项目 UUID 白名单；留空表示该 MCP 身份可访问的全部项目。
SHOUSHOU_MCP_PROJECT_IDS=
# 只允许从这些目录导入渲染成片；Windows 使用分号分隔多个绝对路径。
SHOUSHOU_MCP_IMPORT_ROOTS=H:\CodexStorage
SHOUSHOU_MCP_MAX_IMPORT_BYTES=1073741824
