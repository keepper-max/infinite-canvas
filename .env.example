# 生产环境必须替换为 ECS 内网地址或云数据库地址
DATABASE_URL=postgresql://studio:change-me@db:5432/jingjie
REDIS_URL=redis://redis:6379

# MinIO / OSS S3 兼容存储
S3_ENDPOINT=http://minio:9000
S3_BUCKET=jingjie-assets
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me

# HTTPS 域名上线后改为 true
COOKIE_SECURE=true

# 预留接口状态开关；不填也不会影响 Mock 任务
CREDITS_PROVIDER=mock
PAYMENT_PROVIDER=unconfigured
SMS_PROVIDER=unconfigured

# OpenAI-compatible AI gateway (keep the real key out of git)
TOKEN360_API_KEY=
ASSISTANT_BASE_URL=https://api.token360.ai/v1
ASSISTANT_MODEL=qwen3.8-flash
